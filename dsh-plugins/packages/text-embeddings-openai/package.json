{
  "name": "dsh-text-embeddings-openai",
  "version": "0.1.0",
  "description": "Generic OpenAI-compatible /embeddings provider for ctx.textEmbeddings in DeepSeek Harness",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "embeddings", "text-embeddings", "openai"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "publishConfig": { "access": "public" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "dsh-text-embeddings": "^0.1.0",
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.1"
  },
  "devDependencies": {
    "dsh-text-embeddings": "workspace:^",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  }
}
